 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Brand Selection Analysis\n",
    "\n",
    "This notebook analyzes the support conversation dataset to select the optimal brand for the assignment.\n",
    "\n",
    "We evaluate each brand on:\n",
    "- Tweet/message volume and conversation count\n",
    "- Average conversation length and complexity\n",
    "- Customer vs. agent message balance\n",
    "- Data quality (duplicates, noise)\n",
    "- Resolution identification capability\n",
    "- Intent diversity\n"   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "from collections import Counter, defaultdict\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set style for better visualizations\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (14, 6)\n",
    "\n",
    "print(\"Libraries imported successfully.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load and Inspect Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the dataset - adjust path/format as needed\n",
    "# Common formats: CSV, JSON, JSONL\n",
    "\n",
    "# Try loading CSV first\n",
    "try:\n",
    "    df = pd.read_csv('../data/raw_data.csv')\n",
    "    print(\"Loaded CSV file\")\n",
    "except:\n",
    "    try:\n",
    "        # Try JSONL format\n",
    "        with open('../data/raw_data.jsonl', 'r') as f:\n",
    "            data = [json.loads(line) for line in f]\n",
    "        df = pd.DataFrame(data)\n",
    "        print(\"Loaded JSONL file\")\n",
    "    except:\n",
    "        print(\"ERROR: Could not load data. Check file path and format.\")\n",
    "        df = None\n",
    "\n",
    "if df is not None:\n",
    "    print(f\"\\nDataset Shape: {df.shape}\")\n",
    "    print(f\"\\nColumns: {df.columns.tolist()}\")\n",
    "    print(f\"\\nFirst few rows:\")\n",
    "    print(df.head())\n",
    "    print(f\"\\nData types:\\n{df.dtypes}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Brand Overview - Volume Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Identify the brand column (adjust if needed)\n",
    "brand_col = next((col for col in ['brand', 'author_id', 'handle', 'account'] if col in df.columns), None)\n",
    "conv_col = next((col for col in ['conversation_id', 'thread_id', 'tweet_id'] if col in df.columns), None)\n",
    "\n",
    "if brand_col and conv_col:\n",
    "    print(f\"Using columns: brand='{brand_col}', conversation='{conv_col}'\\n\")\n",
    "    \n",
    "    # Generate brand summary table\n",
    "    brand_summary = []\n",
    "    \n",
    "    for brand in sorted(df[brand_col].unique()):\n",
    "        brand_data = df[df[brand_col] == brand]\n",
    "        \n",
    "        tweets = len(brand_data)\n",
    "        conversations = brand_data[conv_col].nunique()\n",
    "        avg_len = tweets / conversations if conversations > 0 else 0\n",
    "        \n",
    "        brand_summary.append({\n",
    "            'Brand': brand,\n",
    "            'Tweets': f\"{tweets:,}\",\n",
    "            'Conversations': f\"{conversations:,}\",\n",
    "            'Avg Msgs/Conv': f\"{avg_len:.1f}\"\n",
    "        })\n",
    "    \n",
    "    summary_df = pd.DataFrame(brand_summary)\n",
    "    print(\"BRAND OVERVIEW\")\n",
    "    print(\"=\"*60)\n",
    "    print(summary_df.to_string(index=False))\n    "else:\n",
    "    print(\"ERROR: Could not identify brand or conversation columns.\")\n",
    "    print(f\"Available columns: {df.columns.tolist()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Detailed Analysis Per Brand"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Detailed metrics for each brand\n",
    "brand_metrics = {}\n",
    "\n",
    "for brand in sorted(df[brand_col].unique()):\n",
    "    brand_data = df[df[brand_col] == brand]\n",
    "    \n",
    "    # Basic counts\n",
    "    num_tweets = len(brand_data)\n",
    "    num_convs = brand_data[conv_col].nunique()\n",
    "    \n",
    "    # Conversation lengths\n",
    "    conv_lengths = brand_data.groupby(conv_col).size()\n",
    "    avg_conv_len = conv_lengths.mean()\n",
    "    max_conv_len = conv_lengths.max()\n",
    "    min_conv_len = conv_lengths.min()\n",
    "    \n",
    "    # Multi-turn conversations (>=3 messages for meaningful dialogue)\n",
    "    multi_turn = (conv_lengths >= 3).sum()\n",
    "    multi_turn_pct = (multi_turn / num_convs * 100) if num_convs > 0 else 0\n",
    "    \n",
    "    # Duplicate analysis\n",
    "    duplicates = brand_data.duplicated().sum()\n",
    "    \n",
    "    # Message sender analysis (if available)\n",
    "    sender_col = next((col for col in ['sender', 'author', 'role'] if col in brand_data.columns), None)\n",
    "    if sender_col:\n",
    "        customer_msgs = (brand_data[sender_col].str.lower().str.contains('customer|user|@', na=False)).sum()\n",
    "        agent_msgs = (brand_data[sender_col].str.lower().str.contains('agent|support|@' + brand.lower(), na=False)).sum()\n",
    "    else:\n",
    "        customer_msgs = 0\n",
    "        agent_msgs = 0\n",
    "    \n",
    "    brand_metrics[brand] = {\n",
    "        'tweets': num_tweets,\n",
    "        'conversations': num_convs,\n",
    "        'avg_conv_len': avg_conv_len,\n",
    "        'max_conv_len': max_conv_len,\n",
    "        'min_conv_len': min_conv_len,\n",
    "        'multi_turn': multi_turn,\n",
    "        'multi_turn_pct': multi_turn_pct,\n",
    "        'duplicates': duplicates,\n",
    "        'customer_msgs': customer_msgs,\n",
    "        'agent_msgs': agent_msgs\n",
    "    }\n",
    "\n",
    "# Display detailed metrics\n",
    "print(\"DETAILED BRAND METRICS\")\n",
    "print(\"=\"*80)\n",
    "for brand, metrics in sorted(brand_metrics.items()):\n",
    "    print(f\"\\n{brand.upper()}\")\n",
    "    print(\"-\" * 80)\n",
    "    print(f\"  Total Tweets:              {metrics['tweets']:,}\")\n",
    "    print(f\"  Total Conversations:       {metrics['conversations']:,}\")\n",
    "    print(f\"  Avg Messages per Conv:     {metrics['avg_conv_len']:.2f}\")\n",
    "    print(f\"  Conv Length Range:         {metrics['min_conv_len']} - {metrics['max_conv_len']}\")\n",
    "    print(f\"  Multi-turn Conversations:  {metrics['multi_turn']:,} ({metrics['multi_turn_pct']:.1f}%)\")\n",
    "    print(f\"  Duplicates:                {metrics['duplicates']:,}\")\n",
    "    if metrics['customer_msgs'] > 0 or metrics['agent_msgs'] > 0:\n",
    "        print(f\"  Customer Messages:         {metrics['customer_msgs']:,}\")\n",
    "        print(f\"  Agent Messages:            {metrics['agent_msgs']:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Resolution Detection Analysis"
   ]
  },
  {
   "function_calls>
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Identify resolutions by looking for common resolution keywords\n",
    "resolution_keywords = [\n",
    "    'resolved', 'fixed', 'solved', 'thank', 'thanks', 'appreciate',\n",
    "    'helped', 'working', 'works', 'issue is closed', 'closed',\n",
    "    'problem solved', 'answered', 'provided', 'solution',\n",
    "    'support', 'assist', 'help', 'done', 'completed'\n",
    "]\n",
    "\n",
    "# Text column identification\n",
    "text_col = next((col for col in ['text', 'message', 'content', 'tweet'] if col in df.columns), None)\n",
    "\n",
    "if text_col:\n",
    "    resolution_analysis = {}\n",
    "    \n",
    "    for brand in sorted(df[brand_col].unique()):\n",
    "        brand_data = df[df[brand_col] == brand]\n",
    "        \n",
    "        # Group by conversation\n",
    "        conv_groups = brand_data.groupby(conv_col)\n",
    "        \n",
    "        convs_with_resolution = 0\n",
    "        \n",
    "        for conv_id, conv_data in conv_groups:\n",
    "            # Check if any message in the conversation contains resolution keywords\n",
    "            conv_text = ' '.join(conv_data[text_col].fillna('').astype(str)).lower()\n",
    "            \n",
    "            if any(kw in conv_text for kw in resolution_keywords):\n",
    "                convs_with_resolution += 1\n",
    "        \n",
    "        total_convs = conv_groups.ngroups\n",
    "        resolution_pct = (convs_with_resolution / total_convs * 100) if total_convs > 0 else 0\n",
    "        \n",
    "        resolution_analysis[brand] = {\n",
    "            'convs_with_resolution': convs_with_resolution,\n",
    "            'total_convs': total_convs,\n",
    "            'resolution_pct': resolution_pct\n",
    "        }\n",
    "    \n",
    "    print(\"RESOLUTION DETECTION ANALYSIS\")\n",
    "    print(\"=\"*60)\n",
    "    for brand, metrics in sorted(resolution_analysis.items()):\n",
    "        print(f\"\\n{brand.upper()}\")\n",
    "        print(f\"  Conversations with resolution indicators: {metrics['convs_with_resolution']:,} / {metrics['total_convs']:,}\")\n",
    "        print(f\"  Resolution rate: {metrics['resolution_pct']:.1f}%\")\nelse:\n",
    "    print(\"Could not identify text column for resolution analysis.\")\n",
    "    print(f\"Available columns: {df.columns.tolist()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Data Quality Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create comparison visualizations\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "brands = sorted(df[brand_col].unique())\n",
    "conversation_counts = [brand_metrics[b]['conversations'] for b in brands]\n",
    "avg_lengths = [brand_metrics[b]['avg_conv_len'] for b in brands]\n",
    "multi_turn_pcts = [brand_metrics[b]['multi_turn_pct'] for b in brands]\n",
    "\n",
    "# Plot 1: Conversation Count\n",
    "axes[0, 0].barh(brands, conversation_counts, color='steelblue')\n",
    "axes[0, 0].set_xlabel('Number of Conversations')\n",
    "axes[0, 0].set_title('Conversation Volume by Brand')\n",
    "axes[0, 0].grid(axis='x', alpha=0.3)\n",
    "\n",
    "# Plot 2: Average Conversation Length\n",
    "axes[0, 1].barh(brands, avg_lengths, color='coral')\n",
    "axes[0, 1].set_xlabel('Average Messages per Conversation')\n",
    "axes[0, 1].set_title('Conversation Complexity by Brand')\n",
    "axes[0, 1].grid(axis='x', alpha=0.3)\n",
    "\n",
    "# Plot 3: Multi-turn Percentage\n",
    "axes[1, 0].barh(brands, multi_turn_pcts, color='mediumseagreen')\n",
    "axes[1, 0].set_xlabel('Percentage (%)')\n",
    "axes[1, 0].set_title('Multi-turn Conversations (>=3 messages) by Brand')\n",
    "axes[1, 0].grid(axis='x', alpha=0.3)\n",
    "\n",
    "# Plot 4: Resolution Rate\n",
    "if 'resolution_pct' in locals():\n",
    "    resolution_pcts = [resolution_analysis[b]['resolution_pct'] for b in brands]\n",
    "    axes[1, 1].barh(brands, resolution_pcts, color='mediumpurple')\n",
    "    axes[1, 1].set_xlabel('Percentage (%)')\n",
    "    axes[1, 1].set_title('Conversations with Resolution Indicators by Brand')\n",
    "    axes[1, 1].grid(axis='x', alpha=0.3)\nelse:\n",
    "    axes[1, 1].text(0.5, 0.5, 'Resolution analysis unavailable', ha='center', va='center')\n    axes[1, 1].axis('off')\n\nplt.tight_layout()\nplt.savefig('../evaluation/brand_comparison.png', dpi=150, bbox_inches='tight')\nplt.show()\n\nprint(\"Comparison charts saved to evaluation/brand_comparison.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Scoring and Recommendation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate composite score for each brand\n",
    "# Weights: conversation volume, multi-turn %, resolution rate, data quality\n",
    "\n",
    "scores = {}\n",
    "\n",
    "for brand in brands:\n",
    "    metrics = brand_metrics[brand]\n",
    "    \n",
    "    # Normalize each metric to 0-100 scale\n",
    "    conv_score = min(100, (metrics['conversations'] / max([brand_metrics[b]['conversations'] for b in brands])) * 100)\n",
    "    multi_turn_score = metrics['multi_turn_pct']  # Already 0-100\n",
    "    avg_len_score = min(100, (metrics['avg_conv_len'] / 5) * 100)  # 5+ msgs is excellent\n",
    "    \n",
    "    if 'resolution_pct' in locals():\n",
    "        resolution_score = resolution_analysis[brand]['resolution_pct']\n",
    "    else:\n",
    "        resolution_score = 50  # Default if unavailable\n",
    "    \n",
    "    # Quality penalty for duplicates\n",
    "    quality_penalty = min(10, metrics['duplicates'] / 100)\n",
    "    \n",
    "    # Composite score (weighted average)\n",
    "    final_score = (\n",
    "        conv_score * 0.30 +           # 30% conversation volume\n",
    "        multi_turn_score * 0.25 +     # 25% multi-turn ratio\n",
    "        avg_len_score * 0.20 +        # 20% conversation length\n",
    "        resolution_score * 0.25 -     # 25% resolution rate\n",
    "        quality_penalty                # Minus duplicates\n",
    "    )\n",
    "    \n",
    "    scores[brand] = final_score\n",
    "\n",
    "# Rank brands\n",
    "ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)\n",
    "\n",
    "print(\"\\nBRAND SCORING & RANKING\")\n",
    "print(\"=\"*60)\n",
    "for rank, (brand, score) in enumerate(ranked, 1):\n",
    "    print(f\"{rank}. {brand:20s} → Score: {score:.1f}\")\n\n# Select best brand\nbest_brand = ranked[0][0]\nbest_metrics = brand_metrics[best_brand]\n\nprint(f\"\\n{'='*60}\")\nprint(f\"SELECTED BRAND: {best_brand.upper()}\")\nprint(f\"{'='*60}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Final Recommendation & Justification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate final recommendation statement\n",
    "\n",
    "best_metrics = brand_metrics[best_brand]\n",
    "best_resolution = resolution_analysis[best_brand]['resolution_pct'] if 'resolution_pct' in locals() else 0\n",
    "\n",
    "recommendation = f\"\"\"\n╔════════════════════════════════════════════════════════════════╗\n║                  BRAND SELECTION CONCLUSION                     ║\n╚════════════════════════════════════════════════════════════════╝\n\n🎯 SELECTED BRAND: {best_brand.upper()}\n\n📊 KEY METRICS:\n   • Total Conversations:        {best_metrics['conversations']:,}\n   • Unique Messages/Tweets:     {best_metrics['tweets']:,}\n   • Avg Messages per Conv:      {best_metrics['avg_conv_len']:.2f}\n   • Multi-turn Conversations:   {best_metrics['multi_turn']:,} ({best_metrics['multi_turn_pct']:.1f}%)\n   • Conversations with Resolution: {best_resolution:.1f}%\n   • Data Quality (duplicates):  {best_metrics['duplicates']:,}\n\n✅ JUSTIFICATION:\n\nWe selected {best_brand.upper()} because:\n\n1. SUFFICIENT VOLUME: {best_metrics['conversations']:,} conversations provide sufficient\n   data for training intent classifiers and building a 200-example gold set\n   while maintaining reasonable diversity.\n\n2. CONVERSATION COMPLEXITY: With an average of {best_metrics['avg_conv_len']:.2f} messages per\n   conversation and {best_metrics['multi_turn_pct']:.1f}% multi-turn conversations, this brand\n   demonstrates adequate back-and-forth dialogue for developing\n   retrieval-based response generation.\n\n3. RESOLVABLE PATTERNS: {best_resolution:.1f}% of conversations contain identifiable\n   resolution indicators, enabling us to identify positive examples\n   for the gold set and establish success criteria for the system.\n\n4. INTENT DIVERSITY: The conversation volume and complexity suggest\n   a rich set of recurring customer-support intents (e.g., account\n   issues, billing, technical support, order status), suitable for\n   building a meaningful intent taxonomy.\n\n5. EVALUATION FEASIBILITY: This dataset is large enough for training\n   and evaluation while being manageable for a single-person assignment.\n\n✓ READY FOR NEXT PHASE: Conversation reconstruction and intent taxonomy\n   development can proceed with {best_brand.upper()}.\n\n╚════════════════════════════════════════════════════════════════╝\n\"\"\"\n\nprint(recommendation)\n\n# Save recommendation to file\nwith open('../decision_log.md', 'a') as f:\n    f.write(f\"\\n\\n## Brand Selection (2024-{pd.Timestamp.now().strftime('%m-%d')}\\n\")\n    f.write(recommendation)"
   ]
  }
 ],
